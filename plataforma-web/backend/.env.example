# El backend NO usa un .env propio:
#   - Local: lee el `.env` de la raiz del proyecto (dos niveles arriba de esta carpeta).
#   - Azure (Web App "items"): las mismas claves van en Configuracion > Variables de
#     entorno de la Web App; si existen, mandan sobre el archivo. Ver app/config.py.
#
# Se hizo asi para no tener el mismo secreto copiado en dos archivos.
#
# Siesa Connekta
ConniKey=
ConniToken=
API_CREACION_ITEMS=
# Trae el marcador literal {idSistema}
API_CREACION_MARCAS=
# Opcional (default 2): reemplaza {idSistema} en API_CREACION_MARCAS
ID_SISTEMA=
API_CREACION_PARAM_PLANEACION=
API_RUTAS=
# Opcional (default koscolombia_Items_odoo_crm): consulta de items-extension que se
# valida en vivo contra duplicados y que usa el sync. Ver sql/koscolombia_Items_odoo_crm_v3.sql
CONSULTA_ITEMS=
#
# Azure SQL (base kx_ecommerce, esquema items)
BD_HOST=
BD_NAME=
BD_USER=
BD_PASSWORD=
#
# Datalake (adjuntos): cadena de conexion de la cuenta de almacenamiento
AZURE_STORAGE_ACCOUNT=
#
# Sesion: 1 en produccion (HTTPS); local se deja en 0
COOKIE_SECURE=
#
# Correos de avance: flujo de n8n plataforma-web/n8n/notificaciones-items.json
# Production URL del Webhook. Solo el servidor que la tenga envia (Azure); sin ella los
# correos quedan en cola en items.notificaciones.
N8N_WEBHOOK_URL=
# Secreto del encabezado X-KOS-Token; el mismo valor va en la credencial Header Auth del Webhook
N8N_WEBHOOK_TOKEN=
# Direccion publica de la plataforma, para el boton "Ver en la plataforma" de los correos
APP_URL=
